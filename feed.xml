---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title }}</title>
    <description>{{ site.description }}</description>
    <link>{{ site.url }}</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {% assign poems = site.html_pages | where_exp: "p", "p.url contains '/poems/'" | sort: "url" %}
    {% for poem in poems %}
    <item>
      <title>{{ poem.poem_title | default: poem.title }}</title>
      <link>{{ site.url }}{{ poem.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ poem.url }}</guid>
      {% if poem.description %}<description>{{ poem.description | xml_escape }}</description>{% endif %}
    </item>
    {% endfor %}
    {% for file in site.static_files %}
    {% if file.path contains '/poems/' and file.extname == '.html' %}
    {% unless poems | map: "url" | contains: file.path %}
    <item>
      <title>{{ file.basename | replace: '-', ' ' }}</title>
      <link>{{ site.url }}{{ file.path }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ file.path }}</guid>
    </item>
    {% endunless %}
    {% endif %}
    {% endfor %}
  </channel>
</rss>
