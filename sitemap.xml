---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign pages = site.html_pages | sort: "url" %}
  {% for p in pages %}
  {% unless p.url contains '/404' %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    <changefreq>{% if p.url == '/' %}weekly{% elsif p.url contains '/poems/' %}yearly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if p.url == '/' %}1.0{% elsif p.url contains '/poems/' %}0.8{% else %}0.6{% endif %}</priority>
  </url>
  {% endunless %}
  {% endfor %}
  {% for file in site.static_files %}
  {% if file.path contains '/poems/' and file.extname == '.html' %}
  <url>
    <loc>{{ site.url }}{{ file.path }}</loc>
    <changefreq>yearly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endif %}
  {% endfor %}
</urlset>
