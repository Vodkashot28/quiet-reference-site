  <url><loc>{{ site.url }}/fragments.html</loc><changefreq>monthly</changefreq><priority>0.7</priority></url>
  <url><loc>{{ site.url }}/letters-unsent.html</loc><changefreq>monthly</changefreq><priority>0.7</priority></url>
