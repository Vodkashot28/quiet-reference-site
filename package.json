{
  "name": "quietreference-site",
  "version": "1.0.0",
  "description": "Static site built with Jekyll, deployed via IPFS, and styled with LESS/Stylus.",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run build:cards",
    "build:css": "lessc --clean-css --autoprefix style.less static/css/main.css",
    "build:js": "mkdir -p static/js && browserify js/popup.js -o static/js/popup.js && browserify js/stars.js -o static/js/stars.js && browserify js/poem.js -o static/js/poem.js && browserify js/theme.js -o static/js/theme.js",
    "build:jekyll": "bundle exec jekyll build",
    "build:cards": "node scripts/build-cards.js",
    "deploy": "npm run build && bundle exec jekyll build && ipfs add -r _site",
    "deploy:surge": "npm run build && bundle exec jekyll build && surge --project _site --domain ipfs.surge.sh",
    "minify": "npm-run-all minify:*",
    "minify:img": "find _site/images -type d -exec imagemin {}/* --out-dir={} \\;",
    "minify:js": "find _site/js -name '*.js' -exec uglifyjs {} --compress --output {} \\;",
    "watch": "npm-run-all -p watch:*",
    "watch:css": "nodemon --watch style.less --exec \"lessc --clean-css --autoprefix style.less static/css/main.css\"",
    "watch:js": "nodemon --watch js --exec \"npm run build:js\"",
    "watch:jekyll": "bundle exec jekyll serve --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "autoprefixer-stylus": "^1.0.0",
    "browserify": "^17.0.1",
    "dnslink-deploy": "^1.0.7",
    "factor-bundle": "^2.5.0",
    "imagemin-cli": "^8.0.0",
    "imagemin-jpegtran": "^8.0.0",
    "imagemin-optipng": "^8.0.0",
    "imagemin-svgo": "^11.0.1",
    "jquery": "^3.7.1",
    "less": "^4.6.4",
    "less-plugin-autoprefix": "^2.0.0",
    "less-plugin-clean-css": "^1.5.1",
    "magnific-popup": "^1.1.0",
    "node-static": "^0.7.9",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "pixi.js": "^4.8.9",
    "sharp": "^0.34.5",
    "standard": "^17.1.2",
    "stylus": "^0.64.0",
    "uglify-js": "^3.6.0",
    "watchify": "^4.0.0"
  },
  "standard": {
    "ignore": [
      "content/docs/examples/"
    ]
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
